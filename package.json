{
  "name": "dsh-azai-break",
  "version": "1.1.1",
  "description": "A stable assistant persona for DeepSeek Harness. Gives your assistant a fixed name, a consistent voice, and a working style that does not open with apologies.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "system-prompt"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2",
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible"
      }
    }
  }
}
